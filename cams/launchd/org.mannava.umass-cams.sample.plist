<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- UMass dining-hall busy sampler: runs umass_cams.sample every 180 s from the
     ~/Services/umass-cams venv. Settings in ~/Services/umass-cams/.env; the Mongo
     URI is read from the file that env names (the MealScholar app env), never
     copied. Logs: ~/Library/Logs/umass-cams/.
     Install:  cp this file ~/Library/LaunchAgents/ && launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/org.mannava.umass-cams.sample.plist
     Run now:  launchctl kickstart gui/$(id -u)/org.mannava.umass-cams.sample
     Remove:   launchctl bootout gui/$(id -u)/org.mannava.umass-cams.sample -->
<dict>
	<key>Label</key>
	<string>org.mannava.umass-cams.sample</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/rio/Services/umass-cams/.venv/bin/python</string>
		<string>-I</string>
		<string>-m</string>
		<string>umass_cams.sample</string>
		<string>--screenshots</string>
		<string>/Users/rio/Services/umass-cams/state/player-state</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/Users/rio/Services/umass-cams</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/bin:/bin</string>
		<key>HOME</key>
		<string>/Users/rio</string>
		<key>PYTHONUNBUFFERED</key>
		<string>1</string>
		<key>OMP_NUM_THREADS</key>
		<string>4</string>
		<key>YOLO_VERBOSE</key>
		<string>False</string>
	</dict>
	<key>StartInterval</key>
	<integer>180</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>ProcessType</key>
	<string>Background</string>
	<key>LowPriorityIO</key>
	<true/>
	<key>Nice</key>
	<integer>10</integer>
	<key>StandardOutPath</key>
	<string>/Users/rio/Library/Logs/umass-cams/sample.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/rio/Library/Logs/umass-cams/sample.error.log</string>
</dict>
</plist>
